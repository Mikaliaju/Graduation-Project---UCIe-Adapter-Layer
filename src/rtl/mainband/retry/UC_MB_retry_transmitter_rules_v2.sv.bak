import UC_MB_retry_pkg::*;

module UC_MB_retry_transmitter_rules_v2 (
    input  logic                    clk,
    input  logic                    rst_n,
    input  logic                    init,
    input  logic                    i_snh_done,
    input  logic                    i_snh_timeout,
    input  logic                    i_replay_scheduled,
    input  replay_schedule_type_t   i_replay_scheduled_type,
    input  logic                    i_nak_scheduled,
    input  nak_schedule_type_t      i_nak_schedule_type,
    input  logic                    i_consecutive_reset,
    input  logic [7:0]              i_tx_acknak_flit_seq_num,
    input  logic                    i_tx_en,
    input  logic                    i_buffer_state,
    input  logic                    i_fdi_active,
    input  logic                    i_flit_valid, // from transmitter 
    input  data_rate_t              i_data_rate,
    input  logic                    i_clear_flit_replay_num,
    input  logic [7:0]              i_tx_replay_flit_seq_num,
    input  logic [7:0]              i_nak_ignore_flit_seq_num,
    input  logic [7:0]              i_ackd_flit_seq_num,
    output logic [7:0]              o_next_tx_flit_seq_num,
    output logic [8:0]              o_replay_timeout_flit_count,
    output replay_command_t         o_tx_replay_command,
    output logic                    o_pl_trdy_control,
    output phase_t                  o_tx_phase,
    output logic [7:0]              o_tx_seq_num,
    output logic                    o_rdi_retrain,
    output logic                    o_replay_in_progress,
    output logic                    o_log_cie
);

logic [2:0] r_flit_replay_num;
logic [2:0] w_flit_replay_num;

logic w_log_cie;
logic w_rdi_retrain;
logic w_replay_in_progress;
logic w_pl_trdy_control;
logic [7:0] w_tx_seq_num;
logic [7:0] w_next_tx_flit_seq_num;
logic [8:0] w_replay_timeout_flit_count;
logic [2:0] w_consecutive_tx_explicit_seq_num;
logic [1:0] w_consecutive_tx_nak_flits;
replay_command_t w_tx_replay_command;

flit_type_t tx_flit_type; 
assign tx_flit_type = (o_pl_trdy_control) ? NOP : PAYLOAD;

phase_t current_phase, next_phase;
assign o_tx_phase = current_phase;

logic [2:0] r_consecutive_tx_nak_flits;
logic [2:0] r_consecutive_tx_explicit_seq_num;
logic [7:0] r_next_tx_flit_seq_num;
logic [8:0] r_replay_timeout_flit_count;

always_ff @ (posedge clk or negedge rst_n) begin
    if(!rst_n)
        current_phase <= R_IDLE;
    else if(!init || i_tx_en == 0) 
        current_phase <= R_IDLE;
    else
        current_phase <= next_phase;
end

always_ff @ (posedge clk or negedge rst_n) begin
    if(!rst_n) begin
        o_log_cie <= 0;
        o_rdi_retrain <= 0;
        o_replay_in_progress <= 0;
        o_pl_trdy_control <= 1'b0;
        o_tx_seq_num <= 8'h0;
        o_next_tx_flit_seq_num <= 8'b1;
        o_replay_timeout_flit_count <= 9'b0;
        r_consecutive_tx_explicit_seq_num <= 3'b0;
        r_consecutive_tx_nak_flits <= 3'b0;
        o_tx_replay_command <= explicit;
        r_next_tx_flit_seq_num <= 8'b1;
        r_replay_timeout_flit_count <= 9'b0;
        r_flit_replay_num <= 3'b0;
end
    else if(!init || i_tx_en == 0) begin
        o_log_cie <= 0;
        o_rdi_retrain <= 0;
        o_replay_in_progress <= 0;
        o_pl_trdy_control <= 1'b0;
        o_tx_seq_num <= 8'h0;
        o_next_tx_flit_seq_num <= 8'b1;
        o_replay_timeout_flit_count <= 9'b0;
        r_consecutive_tx_explicit_seq_num <= 3'b0;
        r_consecutive_tx_nak_flits <= 3'b0;
        o_tx_replay_command <= explicit;
        r_next_tx_flit_seq_num <= 8'b1;
        r_replay_timeout_flit_count <= 9'b0;
        r_flit_replay_num <= 3'b0;
end
    else begin
        o_log_cie <= w_log_cie;
        o_rdi_retrain <= w_rdi_retrain;
        o_replay_in_progress <= w_replay_in_progress;
        o_pl_trdy_control <= w_pl_trdy_control;
        o_tx_seq_num <= w_tx_seq_num;
        o_next_tx_flit_seq_num <= w_next_tx_flit_seq_num;
        r_consecutive_tx_explicit_seq_num <= w_consecutive_tx_explicit_seq_num;
        r_consecutive_tx_nak_flits <= w_consecutive_tx_nak_flits;
        o_tx_replay_command <= w_tx_replay_command;
        r_next_tx_flit_seq_num <= (w_next_tx_flit_seq_num == 8'hff) ? 8'h1 : w_next_tx_flit_seq_num;
        r_replay_timeout_flit_count <= w_replay_timeout_flit_count;
        r_flit_replay_num <= (i_clear_flit_replay_num) ? 3'b000 : w_flit_replay_num;
    end
end

always_comb begin
        IDLE_CASE();
        next_phase = current_phase;
        if(i_flit_valid) begin
        case(current_phase)
        R_IDLE : begin
            IDLE_CASE();
                if(i_tx_en) begin
                    next_phase = SNH;
                    SNH_CASE();
                end
        end
        SNH : begin 
            SNH_CASE();
                if(i_fdi_active) begin
                    next_phase = SNH_FDI_ACTIVE;
                    SNH_FDI_ACTIVE_CASE();
                end
                else begin
                    next_phase = SNH;
                    SNH_CASE();
                end
        end
        SNH_FDI_ACTIVE : begin
            SNH_FDI_ACTIVE_CASE();
            if(i_snh_done) begin
                next_phase = NORMAL_EXCHANGE;
                NORMAL_EXCHANGE_CASE();
            end
            else if(i_snh_timeout) begin
                next_phase = R_IDLE;
                w_rdi_retrain = 1;
            end
        end
        NORMAL_EXCHANGE : begin
            NORMAL_EXCHANGE_CASE();
        end 
        endcase
    end
end

  function automatic void IDLE_CASE();
    w_next_tx_flit_seq_num = r_next_tx_flit_seq_num;
    w_replay_timeout_flit_count = r_replay_timeout_flit_count;
    w_consecutive_tx_nak_flits = r_consecutive_tx_nak_flits;
    w_consecutive_tx_explicit_seq_num = r_consecutive_tx_explicit_seq_num;
    w_tx_replay_command = o_tx_replay_command;
    w_tx_seq_num = o_tx_seq_num;
    w_pl_trdy_control = o_pl_trdy_control;
    w_replay_in_progress = o_replay_in_progress;
    w_log_cie = o_log_cie;
    w_rdi_retrain = o_rdi_retrain;
    w_flit_replay_num = r_flit_replay_num;
  endfunction

  function automatic void SNH_CASE();
    w_tx_replay_command = explicit;
    w_tx_seq_num = 8'hFF;
    w_pl_trdy_control = 1'b1;
    w_consecutive_tx_explicit_seq_num = r_consecutive_tx_explicit_seq_num + 1;
  endfunction

  function automatic void SNH_FDI_ACTIVE_CASE();
    w_pl_trdy_control = 1'b0;
    if (((r_next_tx_flit_seq_num - i_ackd_flit_seq_num) % 8'hFF) > MAX_UNACKNOWLEDGED_FLITS)
      w_pl_trdy_control = 1'b1;

    if (!i_replay_scheduled) begin
      if (r_consecutive_tx_explicit_seq_num < 1) begin
        w_tx_replay_command = explicit;
        w_consecutive_tx_explicit_seq_num = r_consecutive_tx_explicit_seq_num + 1;
        if (i_buffer_state != empty) w_replay_timeout_flit_count = r_replay_timeout_flit_count + 1;
        if (tx_flit_type == NOP) begin
          w_tx_seq_num = r_next_tx_flit_seq_num;
        end else begin
          w_tx_seq_num = r_next_tx_flit_seq_num;
          w_next_tx_flit_seq_num = r_next_tx_flit_seq_num + 1;
        end
      end else if (i_nak_scheduled && i_nak_schedule_type == standard_nak) begin
        w_tx_replay_command = nak;
        w_tx_seq_num = i_tx_acknak_flit_seq_num;
        w_consecutive_tx_explicit_seq_num = 'b0;
        if (tx_flit_type != NOP) begin
          w_next_tx_flit_seq_num = r_next_tx_flit_seq_num + 1;
        end
      end else begin
        w_tx_replay_command = ack;
        w_tx_seq_num = i_tx_acknak_flit_seq_num;
        w_consecutive_tx_explicit_seq_num = 'b0;
        if (tx_flit_type != NOP) begin
          w_next_tx_flit_seq_num = r_next_tx_flit_seq_num + 1;
        end
      end
    end else begin  // -- REPLAY PATH -- 
      if (r_consecutive_tx_explicit_seq_num < 1) begin
        flit_replay_transmit_0();
      end else if (o_replay_in_progress) begin
        w_tx_seq_num = o_tx_seq_num + 1;
        if (o_tx_seq_num == r_next_tx_flit_seq_num - 1) begin
          w_replay_in_progress = 1'b0;
          w_pl_trdy_control = 1'b0;
        end
      end
    end
    flit_replay_transmit_2();
  endfunction

  function automatic void NORMAL_EXCHANGE_CASE();
    if (normal_exchange_explicit_condition()) begin
      w_tx_replay_command = explicit;
      w_consecutive_tx_nak_flits = 'b0;
      // -- REPLAY PATH -- 
      if (i_replay_scheduled && i_replay_scheduled_type == standard_replay) begin
        flit_replay_transmit_0();
      end else if (o_replay_in_progress) begin
        w_tx_seq_num = o_tx_seq_num + 1;
        if (o_tx_seq_num == r_next_tx_flit_seq_num - 1) begin
          w_replay_in_progress = 1'b0;
          w_pl_trdy_control = 1'b0;
        end
      end else begin
        // -- NORMAL PATH -- 
        w_consecutive_tx_explicit_seq_num = r_consecutive_tx_explicit_seq_num + 1;
        if (i_buffer_state != empty) w_replay_timeout_flit_count = r_replay_timeout_flit_count + 1;
        if (((r_next_tx_flit_seq_num - i_ackd_flit_seq_num) % 8'hFF) > MAX_UNACKNOWLEDGED_FLITS)
          w_pl_trdy_control = 1'b1;
        else w_pl_trdy_control = 1'b0;

        if (tx_flit_type == NOP) begin
          w_tx_seq_num = r_next_tx_flit_seq_num;
        end else begin
          w_tx_seq_num = r_next_tx_flit_seq_num;
          w_next_tx_flit_seq_num = r_next_tx_flit_seq_num + 1;
        end
      end
    end else if ((i_nak_scheduled && i_nak_schedule_type == standard_nak)) begin
      w_tx_replay_command = nak;
      w_tx_seq_num = i_tx_acknak_flit_seq_num;
      w_consecutive_tx_nak_flits = r_consecutive_tx_nak_flits + 1;
      w_consecutive_tx_explicit_seq_num = 0;
      if (tx_flit_type != NOP) begin
        w_next_tx_flit_seq_num = r_next_tx_flit_seq_num + 1;
      end
    end else begin
      w_tx_replay_command = ack;
      w_tx_seq_num = i_tx_acknak_flit_seq_num;
      w_consecutive_tx_nak_flits = 'b0;
      w_consecutive_tx_explicit_seq_num = 0;
      if (tx_flit_type != NOP) begin
        w_next_tx_flit_seq_num = r_next_tx_flit_seq_num + 1;
      end
    end
    // Check for excessive replays -- triggers retrain
    flit_replay_transmit_2();
  endfunction


  function automatic logic normal_exchange_explicit_condition();
    logic cond_A, cond_B, cond_C, cond_D;
    cond_A = (!i_replay_scheduled)       &&   
             (!o_replay_in_progress)     &&   
             (i_nak_ignore_flit_seq_num != 8'h00);
    cond_B = i_replay_scheduled || o_replay_in_progress || cond_A;
    cond_C = (r_consecutive_tx_explicit_seq_num < 1);
    cond_D = ((r_consecutive_tx_nak_flits == 0) || (r_consecutive_tx_nak_flits > 2));

    return (cond_B && cond_C && cond_D);
  endfunction

  function automatic void flit_replay_transmit_0();
    if (r_flit_replay_num < 3'b110) begin
      if(i_replay_scheduled && !o_replay_in_progress 
            && i_replay_scheduled_type == standard_replay) begin
        if((r_consecutive_tx_nak_flits >= 2 || r_consecutive_tx_nak_flits == 0) 
                && i_data_rate == GTs_32) begin
          w_pl_trdy_control = 1'b1;  //deassert pl_trdy
          w_replay_in_progress = 1'b1;
          w_tx_seq_num = i_tx_replay_flit_seq_num;
          w_flit_replay_num = r_flit_replay_num + 2;
          if (i_consecutive_reset) begin
            w_consecutive_tx_explicit_seq_num = 3'b0;
            w_consecutive_tx_nak_flits = 3'b0;
            w_replay_timeout_flit_count = 9'b0;
          end
        end
      end
    end
  endfunction

  function automatic void flit_replay_transmit_2();
    if (i_replay_scheduled && !o_replay_in_progress) begin
      if (i_data_rate <= GTs_32 && r_flit_replay_num >= 3'b110) begin
        w_flit_replay_num = r_flit_replay_num + 2;
        w_rdi_retrain = 1'b1;
        w_log_cie = 1'b1;
      end
    end
  endfunction
  
endmodule